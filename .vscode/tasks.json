{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "lab5: build AVR asm",
      "type": "shell",
      "command": "make",
      "args": ["all"],
      "options": {
        "cwd": "${workspaceFolder}/labs/lab5"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "avra",
        "fileLocation": ["relative", "${workspaceFolder}/labs/lab5"],
        "pattern": {
          "regexp": "^(.*)\\((\\d+)\\)\\s*:\\s*(Error|Warning)\\s*:\\s*(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    },
    {
      "label": "lab5: clean AVR build",
      "type": "shell",
      "command": "make",
      "args": ["clean"],
      "options": {
        "cwd": "${workspaceFolder}/labs/lab5"
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
